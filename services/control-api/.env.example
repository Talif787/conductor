# Application
CONDUCTOR_ENVIRONMENT=development
CONDUCTOR_LOG_LEVEL=INFO
CONDUCTOR_API_PREFIX=/api/v1
CONDUCTOR_DEFAULT_PAGE_SIZE=20
CONDUCTOR_MAX_PAGE_SIZE=100

# Database
CONDUCTOR_DB_URL=postgresql+asyncpg://conductor:conductor@localhost:5432/conductor
CONDUCTOR_DB_POOL_SIZE=10
CONDUCTOR_DB_MAX_OVERFLOW=20

# Observability
CONDUCTOR_OTEL_SERVICE_NAME=conductor-control-api
CONDUCTOR_OTEL_TRACES_ENABLED=true
# Leave OTLP endpoint empty to run without a collector.
CONDUCTOR_OTEL_OTLP_ENDPOINT=
